# ── Database ────────────────────────────────────────────────────────────────
SCHEDULE_DB_HOST=127.0.0.1
SCHEDULE_DB_PORT=5432
SCHEDULE_DB_NAME=schedule_manager_db
SCHEDULE_DB_USER=postgres
SCHEDULE_DB_PASSWORD=changeme

# ── Local identity ──────────────────────────────────────────────────────────
# The bearer token a local caller (CLI, or an opencode stdio server) presents.
# Issue one with:  schedule-manager user open --username <name>
# Only its SHA-256 digest is stored; this value cannot be recovered from the DB.
#
# Do not commit a real token.  Keep it in each developer's own .env (git-ignored)
# and reference it from a client config with {env:SCHEDULE_TOKEN}.
SCHEDULE_TOKEN=sm_replace_me

# Preferred over SCHEDULE_TOKEN when set, and safe to chmod 600 — an exported
# environment variable is readable via /proc/<pid>/environ.
# SCHEDULE_TOKEN_FILE=~/.config/schedule-manager/token

# ── Remote server (optional; defaults are loopback) ─────────────────────────
# The externally reachable URL.  It becomes the OAuth resource identifier that
# issued tokens are bound to, and it must be HTTPS outside local development.
# SCHEDULE_PUBLIC_URL=https://mcp.example.com
# SCHEDULE_BIND_HOST=0.0.0.0
# SCHEDULE_BIND_PORT=8000

# DNS-rebinding protection is only auto-enabled for a loopback bind host, so on
# a real hostname these have to be set explicitly.
# SCHEDULE_ALLOWED_HOSTS=mcp.example.com
# SCHEDULE_ALLOWED_ORIGINS=https://mcp.example.com

# ── Throughput (optional) ───────────────────────────────────────────────────
# One worker is one event loop on one core.  On a 16-core host, 1 → 8 workers
# measured 2.8x the throughput and 4x lower p50 (see the plan's capacity
# section).  Past ~8 workers the database is the limit, not the CPU.
# SCHEDULE_WORKERS=8

# Every worker opens its own pool, so the server needs WORKERS * POOL_MAX
# connections in total.  Keep that total near 32: the database plateaus at
# roughly 700 queries/second at 2-4 connections.
# SCHEDULE_POOL_MAX=4

# Multiple workers would race on the DDL during startup.  Run `setup-db` once
# and turn this off whenever WORKERS is greater than one.
# SCHEDULE_AUTO_MIGRATE=0

# ── Containers (optional) ────────────────────────────────────────────────────
# docker compose reads this file for ${VAR} substitution, but the image never
# reads it: every setting below reaches the container through `environment:` in
# compose.yaml or through -e.  Keep it that way — this file is where the database
# password and the bearer token live.
#
# SCHEDULE_PUBLIC_URL=https://mcp.example.com   # what a client dials, not the container
# SCHEDULE_LOG_LEVEL=INFO
